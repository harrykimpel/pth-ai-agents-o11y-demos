# Copy to .env. Never commit the filled-in file.
# live = the actual Microsoft Agent Framework + model.
# fixture = deterministic local rehearsal; no model/API calls or LLM spans.
DEMO_ENGINE=live
MSFT_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
MSFT_FOUNDRY_API_KEY=
MODEL_ID=gpt-5-mini

# Optional direct OpenAI alternative: OPENAI_API_KEY / OPENAI_BASE_URL.
# Leave both reasoning values blank if the deployed model/API does not support them.
REASONING_EFFORT=high
REASONING_SUMMARY=detailed
PLANNER_TIMEOUT_S=90

# Explicit demo-only opt-in. Use synthetic prompts; this includes other sensitive
# content too. Set false when you do not want prompts/tool values in telemetry.
ENABLE_SENSITIVE_DATA=true
DEMO_SHOW_REASONING=true
ENABLE_CONSOLE_EXPORTERS=true
OTEL_RESOURCE_ATTRIBUTES=service.version=porto-demos-v1,deployment.environment.name=conference-demo
# Each entry app supplies its own default OTEL_SERVICE_NAME. Leave unset to keep
# Demo 1/2/3 as separate New Relic service entities.
# OTEL_SERVICE_NAME=

# Configure your actual New Relic region and ingest key privately for OTLP export.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_INGEST_KEY
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Local bind by default. Set DEMO_HOST=0.0.0.0 only when your container/forwarding needs it.
# DEMO_HOST=127.0.0.1
# PORT=5002
